// Self-written test gear for ItemSystem; not original content.

== values gear_test
values:
    worn_turns: number 0
    put_on: number 0

== item test_helmet
name: test helmet
description: A dented test helmet.
category: clothing
weight: 3
consumed: no
equipment:
    slot: head
    placement: head
    armor: 60
    effectiveness: 100
    gender look: 1
    style: cool, cute
    worn text: A dented helmet sits on your head.
on wear:
    ~ gear_test.put_on + 1 quietly
worn each turn:
    ~ gear_test.worn_turns + 1 quietly

